export TLS_CERT_PATH="path/to/tls.cert"
export ADMIN_MACAROON_PATH="path/to/admin.macaroon"
export GRPC_HOST="127.0.0.1"
export GRPC_PORT="10003"
export BITCOIN_RPC_HOST_AND_PORT="127.0.0.1:18443"
export BITCOIN_RPC_USER="polaruser"
export BITCOIN_RPC_PASSWORD="polarpass"
export NETWORK="regtest"
export NSEC="my_nsec"
# Generate a long random string, e.g. `openssl rand -hex 32`
export JWT_SECRET="change_me_to_a_long_random_string"
export GITHUB_CLIENT_ID="my_github_client_id"
export GITHUB_CLIENT_SECRET="my_github_client_secret"
# Full origin of the frontend (scheme + host). Used for CORS and OAuth redirects.
export HOST="http://localhost:3000"

# Admin API token (banned/premium user lists). Generate a long random string.
# export ADMIN_TOKEN="change_me_to_a_long_random_string"

# Mainnet LND for paid reorgs and L402 auth
export MAINNET_GRPC_HOST="127.0.0.1"
export MAINNET_GRPC_PORT="10009"
export MAINNET_TLS_CERT_PATH="path/to/mainnet/tls.cert"
export MAINNET_ADMIN_MACAROON_PATH="path/to/mainnet/admin.macaroon"

# Reorg feature configuration
export REORG_ENABLED="false"
export REORG_COOLDOWN_SECONDS="3600"
export REORG_DB_PATH="reorg.db"

# L402 Lightning authentication
export L402_ENABLED="false"
export L402_INVOICE_AMOUNT="1000"

# Analytics database
export ANALYTICS_DB_PATH="analytics.db"
# export ANALYTICS_TOKEN="change_me_to_a_long_random_string"

# Arkade dispenser daemon (internal network)
# Leave unset to disable POST /api/arkade.
export ARKADE_DAEMON_URL="http://arkade-daemon:8080"
# Optional shared secret sent as X-Internal-Token to the daemon.
# export ARKADE_INTERNAL_TOKEN="my_shared_secret"
